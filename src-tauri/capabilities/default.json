{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the notes and settings windows",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "dialog:allow-open",
    "opener:allow-open-url"
  ]
}
