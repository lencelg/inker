{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Notes",
  "version": "0.1.0",
  "identifier": "com.lencelg.markdownnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markdown 笔记",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes",
    "longDescription": "A local-first Markdown notes app with a file tree, tabs, optional Vim editing, math, local images, and HTML preview.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
