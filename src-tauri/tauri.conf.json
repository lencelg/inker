{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markleaf",
  "version": "0.1.0",
  "identifier": "com.lencelg.markdownnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "markleaf",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "markleaf - local-first Markdown notes",
    "longDescription": "markleaf is a local-first Markdown notes app with a file tree, full-text search, tabs, themes, source/preview/live modes, optional Vim editing, math, code highlighting, images, and HTML preview.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
